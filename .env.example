# Which model drives the agents: anthropic:claude-sonnet-4-5 | openai:gpt-4.1-mini | ollama:llama3.1:8b | test:test
LLM_MODEL=ollama:llama3.1:8b
# native (linear pipeline) | langgraph (state graph, pausable for human review)
ORCHESTRATOR=native
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Unset -> SQLite + in-memory vectors. For PostgreSQL + pgvector (docker compose up db):
# DATABASE_URL=postgresql+psycopg://credit:credit@127.0.0.1:5433/credit_ops
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

AUTO_APPROVE_MAX_AMOUNT_UAH=300000
# CRM_WEBHOOK_URL=https://crm.example.com/hooks/leads
LOG_JSON=false

# Tracing (optional): https://logfire.pydantic.dev -> project -> write token
# LOGFIRE_TOKEN=
ENVIRONMENT=dev
